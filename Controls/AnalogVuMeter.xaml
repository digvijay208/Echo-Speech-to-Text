<UserControl x:Class="Echo.Controls.AnalogVuMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="110" Width="200">

    <Border BorderBrush="#0A0B0D" BorderThickness="2" CornerRadius="3" Background="#141518" Padding="2">
        <Border BorderBrush="#3A3C44" BorderThickness="1" CornerRadius="2">
            <!-- Vintage Illuminated Meter Dial Chamber -->
            <Grid Background="{StaticResource Brush.Meter.Backlight}" ClipToBounds="True">

                <!-- Subtle Dial Inner Vignette -->
                <Border BorderBrush="#80B8B29C" BorderThickness="1" CornerRadius="2" />

                <Canvas x:Name="MeterCanvas" Width="190" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Silkscreen Header in Meter Dial -->
                    <TextBlock Text="VU"
                               FontFamily="Segoe UI, Arial"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="#333333"
                               Canvas.Left="88"
                               Canvas.Top="16" />

                    <TextBlock Text="LEVEL"
                               FontFamily="Segoe UI, Arial"
                               FontWeight="SemiBold"
                               FontSize="7"
                               Foreground="#666666"
                               Canvas.Left="84"
                               Canvas.Top="28" />

                    <!-- Calibrated dB Scale Curve Marks (Drawn with Paths/Lines) -->
                    <!-- -20 dB to 0 dB in Dark Green -->
                    <Path Stroke="{StaticResource Brush.Meter.ScaleSafe}" StrokeThickness="2"
                          Data="M 30,55 A 85,85 0 0,1 125,48" />

                    <!-- +1 dB to +6 dB in Rust Red -->
                    <Path Stroke="{StaticResource Brush.Meter.ScaleWarn}" StrokeThickness="2.5"
                          Data="M 127,48 A 85,85 0 0,1 165,58" />

                    <!-- Scale Numbers -->
                    <TextBlock Text="-20" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource Brush.Meter.ScaleSafe}" Canvas.Left="26" Canvas.Top="58" />
                    <TextBlock Text="-10" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource Brush.Meter.ScaleSafe}" Canvas.Left="52" Canvas.Top="48" />
                    <TextBlock Text="-5" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource Brush.Meter.ScaleSafe}" Canvas.Left="82" Canvas.Top="43" />
                    <TextBlock Text="0" FontSize="8" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="#222222" Canvas.Left="123" Canvas.Top="40" />
                    <TextBlock Text="+3" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource Brush.Meter.ScaleWarn}" Canvas.Left="142" Canvas.Top="45" />
                    <TextBlock Text="+6" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{StaticResource Brush.Meter.ScaleWarn}" Canvas.Left="162" Canvas.Top="56" />

                    <!-- PEAK LED Indicator -->
                    <StackPanel Orientation="Horizontal" Canvas.Left="120" Canvas.Top="72">
                        <TextBlock Text="PEAK" FontSize="7" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#555555" Margin="0,1,4,0" />
                        <Ellipse x:Name="PeakLed" Width="7" Height="7" Fill="#330000" Stroke="#111111" StrokeThickness="0.5" />
                    </StackPanel>

                    <!-- The Analog Meter Needle -->
                    <Line x:Name="NeedleLine"
                          X1="95" Y1="105"
                          X2="95" Y2="36"
                          Stroke="{StaticResource Brush.Meter.Needle}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Triangle">
                        <Line.RenderTransform>
                            <!-- Needle Pivot at bottom center (95, 105) -->
                            <!-- Resting position angle: -36 deg (-20 dB), Max angle: +36 deg (+6 dB) -->
                            <RotateTransform x:Name="NeedleTransform" Angle="-36" CenterX="95" CenterY="105" />
                        </Line.RenderTransform>
                    </Line>

                    <!-- Center Needle Pivot Cap (Spun Aluminum) -->
                    <Ellipse Width="24" Height="24" Canvas.Left="83" Canvas.Top="93"
                             Fill="#1B1C1E" Stroke="#3A3C44" StrokeThickness="1" />
                    <Ellipse Width="14" Height="14" Canvas.Left="88" Canvas.Top="98"
                             Fill="#8C8D94" Stroke="#555555" StrokeThickness="0.5" />

                </Canvas>
            </Grid>
        </Border>
    </Border>
</UserControl>
