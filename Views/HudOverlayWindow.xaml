<Window x:Class="Echo.Views.HudOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echo Bar"
        Width="440" Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">

    <Window.Resources>
        <SineEase x:Key="EaseInOut" EasingMode="EaseInOut" />

        <!-- Palette -->
        <SolidColorBrush x:Key="AccentBlue" Color="#4E9BFF" />
        <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA" />
        <SolidColorBrush x:Key="AccentRed" Color="#FF4D5E" />
        <SolidColorBrush x:Key="AccentGreen" Color="#3DDC84" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F2F6" />
        <SolidColorBrush x:Key="TextDim" Color="#8E93A0" />
        <SolidColorBrush x:Key="TextBody" Color="#C7CBD6" />

        <!-- Pulsing animation for the listening dot -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="RecordingDot"
                Storyboard.TargetProperty="Opacity"
                From="1.0" To="0.35" Duration="0:0:0.9"
                AutoReverse="True"
                EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation
                Storyboard.TargetName="RecordingGlow"
                Storyboard.TargetProperty="Opacity"
                From="0.6" To="0.0" Duration="0:0:0.9"
                AutoReverse="True"
                EasingFunction="{StaticResource EaseInOut}" />
            <!-- Glow scales via RenderTransform (compositor-only). The old version
                 animated Width/Height, which forces a full layout pass per frame. -->
            <DoubleAnimation
                Storyboard.TargetName="GlowScale"
                Storyboard.TargetProperty="ScaleX"
                From="1.0" To="1.6" Duration="0:0:0.9"
                AutoReverse="True"
                EasingFunction="{StaticResource EaseInOut}" />
            <DoubleAnimation
                Storyboard.TargetName="GlowScale"
                Storyboard.TargetProperty="ScaleY"
                From="1.0" To="1.6" Duration="0:0:0.9"
                AutoReverse="True"
                EasingFunction="{StaticResource EaseInOut}" />
        </Storyboard>

        <!-- Fade + slide in -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetName="HudContainer"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="HudTranslate"
                Storyboard.TargetProperty="Y"
                From="18" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Ghost pill button used for the ✕ / Undo / Try-again actions -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9CDD8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="HudContainer" Opacity="0" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="HudTranslate" Y="18" />
        </Grid.RenderTransform>

        <!-- The Echo Bar card -->
        <Border x:Name="HudCard"
                CornerRadius="16"
                Margin="12"
                Padding="16,12"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Effect="{StaticResource HudShadow}">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#BE18181E" Offset="0" />
                    <GradientStop Color="#B420202A" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                    <GradientStop Color="#10FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>

            <StackPanel>
                <!-- ================= main row ================= -->
                <Grid MinHeight="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- State icon: five overlapping visuals, one visible at a time -->
                    <Grid Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0">

                        <!-- Idle: mic -->
                        <Border x:Name="IdleVisual"
                                Width="26" Height="26" CornerRadius="13"
                                Background="#2A2A33">
                            <TextBlock x:Name="MicGlyph"
                                       Text="&#xE720;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#E8E8EE"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Listening: pulsing dot + glow -->
                        <Grid x:Name="RecDotVisual" Visibility="Collapsed">
                            <Ellipse x:Name="RecordingGlow" Width="16" Height="16" Opacity="0"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#80FF4D5E" Offset="0" />
                                        <GradientStop Color="#00FF4D5E" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="RecordingDot" Width="10" Height="10" Fill="{StaticResource AccentRed}" />
                        </Grid>

                        <!-- Processing: rotating arc spinner -->
                        <Path x:Name="SpinnerVisual"
                              Visibility="Collapsed"
                              Data="M 13,4 A 9,9 0 1 1 4,13"
                              Stroke="{StaticResource AccentPurple}"
                              StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="26" Height="26" Stretch="None"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Inserted: green check -->
                        <Border x:Name="CheckVisual"
                                Width="26" Height="26" CornerRadius="13"
                                Background="#153527" Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource AccentGreen}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Error: red alert -->
                        <Border x:Name="WarnVisual"
                                Width="26" Height="26" CornerRadius="13"
                                Background="#3A1A1F" Visibility="Collapsed">
                            <TextBlock Text="&#xE783;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#FF5A66"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Center: idle hint / status label / waveform -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel x:Name="IdleTextPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="EchoTitle"
                                       Text="Echo"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                            <Border Width="3" Height="3" CornerRadius="1.5"
                                    Background="#55555F" Margin="10,1,10,0"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="IdleHint"
                                       Text="Press Ctrl + Win to speak"
                                       FontSize="12"
                                       Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                            <TextBlock Text=" &#x2304;"
                                       FontSize="10"
                                       Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center"
                                       Margin="6,1,0,0"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                        </StackPanel>

                        <TextBlock x:Name="CenterLabel"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"
                                   FontFamily="Segoe UI Variable, Segoe UI" />

                        <!-- Waveform bars are generated in code-behind -->
                        <StackPanel x:Name="WavePanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                    </Grid>

                    <!-- Right: elapsed timer (listening) / status (processing) -->
                    <TextBlock x:Name="RightText"
                               Grid.Column="2"
                               FontSize="12"
                               Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Visibility="Collapsed"
                               FontFamily="Segoe UI Variable, Segoe UI" />

                    <!-- Action: ✕ cancel (listening) / Undo (inserted) / Try again (error) -->
                    <Button x:Name="ActionButton"
                            Grid.Column="3"
                            Style="{StaticResource GhostButton}"
                            Visibility="Collapsed"
                            Margin="8,0,0,0"
                            Click="ActionButton_Click" />
                </Grid>

                <!-- ================= transcript row (Inserted state) ================= -->
                <StackPanel x:Name="TranscriptRow" Visibility="Collapsed" Margin="0,8,0,2">
                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="0,0,0,8" />
                    <TextBlock x:Name="TranscriptText"
                               FontSize="12"
                               Foreground="{StaticResource TextBody}"
                               TextWrapping="Wrap"
                               MaxHeight="48"
                               MaxWidth="330"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI Variable, Segoe UI" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mini pill: the resting state after a finished dictation or a
             cancelled/stopped capture. Click to expand back to the full bar. -->
        <Border x:Name="MiniVisual"
                Width="96" Height="12" CornerRadius="6"
                Margin="12"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Background="#B420202A"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                Cursor="Hand"
                ToolTip="Echo — click to expand"
                MouseLeftButtonUp="MiniVisual_Click" />

        <!-- Status flash: temporarily replaces the idle pill's hint with a
             headline + subhead (e.g. "No model loaded" / "Open Settings").
             Fades back to the idle hint after a few seconds. -->
        <Border x:Name="StatusFlashVisual"
                CornerRadius="16"
                Margin="12"
                Padding="12,8"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Background="#CC1A1A22"
                BorderBrush="#3FFFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="StatusFlashHeadline"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#FFD0D4DD"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="StatusFlashSubhead"
                           FontSize="11.5"
                           Foreground="#FF8E93A0"
                           Margin="0,2,0,0"
                           FontFamily="Segoe UI Variable, Segoe UI" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
