<Window x:Class="Echo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Echo.Controls"
        Title="ECHO TC-80 | 1980s Speech Recorder &amp; Dictation"
        Width="880" Height="680"
        MinWidth="760" MinHeight="560"
        Background="{StaticResource Brush.Chassis.BodyDark}"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Brushed Metal Header Strip -->
            <RowDefinition Height="46" />
            <!-- 1: Milled Seam -->
            <RowDefinition Height="2" />
            <!-- 2: Analog Meter & Transport Deck -->
            <RowDefinition Height="140" />
            <!-- 3: Milled Seam -->
            <RowDefinition Height="2" />
            <!-- 4: Main Content Bay (History & Dictionary) -->
            <RowDefinition Height="*" />
            <!-- 5: Bottom Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ������������������������������������������������������������������ -->
        <!-- ROW 0: BRUSHED ALUMINUM TOP DECK STRIP                             -->
        <!-- ������������������������������������������������������������������ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Chassis.BrushedMetal}" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Equipment Brand & Model -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ECHO"
                               FontFamily="Segoe UI, Arial"
                               FontWeight="Black"
                               FontSize="16"
                               Foreground="#1B1C20"
                               Margin="0,0,8,0" />
                    <Border Background="#22242B" CornerRadius="2" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="TC-80"
                                   FontFamily="Consolas, monospace"
                                   FontWeight="Bold"
                                   FontSize="11"
                                   Foreground="#F0F0F2" />
                    </Border>
                    <TextBlock Text="FIELD SPEECH TRANSCRIBER"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="9"
                               Foreground="#555760"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Mechanical Tape Counter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="TAPE COUNTER"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="9"
                               Foreground="#444650"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Border Background="#0A0B0D" BorderBrush="#2C2E35" BorderThickness="1" CornerRadius="2" Padding="8,3">
                        <TextBlock x:Name="TapeCounterText"
                                   Text="00:00.0"
                                   FontFamily="Consolas, monospace"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#E2E2E6" />
                    </Border>
                </StackPanel>

                <!-- Settings Button (Ctrl+,) -->
                <Button Grid.Column="3"
                        Style="{StaticResource Style.Button.Transport}"
                        Padding="10,6"
                        Click="SettingsButton_Click"
                        ToolTip="Settings (Ctrl+,)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙ SETTINGS" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Seam 1 -->
        <Border Grid.Row="1" Style="{StaticResource Style.Panel.Seam}" />

        <!-- ������������������������������������������������������������������ -->
        <!-- ROW 2: INSTRUMENTATION & TRANSPORT DECK                            -->
        <!-- ������������������������������������������������������������������ -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Chassis.Panel}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- VU Meter Bay -->
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <!-- Transport Deck Buttons & Status -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Analog VU Meter -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <controls:AnalogVuMeter x:Name="VuMeter" />
                </StackPanel>

                <!-- Right: Mechanical Transport Deck -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Transport Push Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <!-- Manual Record / Dictate Toggle -->
                        <Button x:Name="RecordButton"
                                Style="{StaticResource Style.Button.Record}"
                                Width="120" Height="42"
                                Margin="0,0,10,0"
                                Click="RecordButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="RecButtonLed" Width="8" Height="8" Fill="#FF4D4D" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecButtonLabel" Text="� REC" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Button>

                        <!-- Stop Button -->
                        <Button x:Name="StopButton"
                                Style="{StaticResource Style.Button.Transport}"
                                Width="90" Height="42"
                                Margin="0,0,16,0"
                                IsEnabled="False"
                                Click="StopButton_Click">
                            <TextBlock Text="■ STOP" FontSize="11" FontWeight="Bold" />
                        </Button>

                        <!-- Hotkey Info Callout Box -->
                        <Border Background="#141518" BorderBrush="#2C2E35" BorderThickness="1" CornerRadius="2" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="PUSH-TO-TALK SHORTCUT" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" />
                                <TextBlock Text="Hold RIGHT CTRL in any app" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Text.SilkscreenBright}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Deck Status Legend -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Ellipse x:Name="PowerLed" Width="7" Height="7" Fill="{StaticResource Brush.Indicator.Power}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="DeckStatusLabel"
                                   Text="STANDBY / READY"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.SilkscreenBright}"
                                   FontFamily="Consolas, monospace"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" | MODEL: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActiveModelLabel" Text="—" FontSize="10" FontWeight="Bold" Foreground="#E09F3E" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Seam 2 -->
        <Border Grid.Row="3" Style="{StaticResource Style.Panel.Seam}" />

        <!-- ������������������������������������������������������������������ -->
        <!-- ROW 4: MAIN CONTENT BAY (HISTORY LOG & DICTIONARY DECK)            -->
        <!-- ������������������������������������������������������������������ -->
        <Grid Grid.Row="4" Background="{StaticResource Brush.Chassis.BodyDark}" Margin="16,12">
            <Grid.RowDefinitions>
                <!-- Bay Tab Selector -->
                <RowDefinition Height="34" />
                <RowDefinition Height="8" />
                <!-- Tab Content Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Tab Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="TabHistoryBtn"
                        Style="{StaticResource Style.Button.Transport}"
                        Padding="18,6"
                        Margin="0,0,4,0"
                        Click="TabHistoryBtn_Click">
                    <Grid>
                        <TextBlock Text="📼 TAPE HISTORY" FontSize="10" FontWeight="Bold" />
                        <Border x:Name="TabHistoryIndicator"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-8"
                                Background="#52B788"
                                Visibility="Collapsed" />
                    </Grid>
                </Button>

                <Button x:Name="TabDictionaryBtn"
                        Style="{StaticResource Style.Button.Transport}"
                        Padding="18,6"
                        Margin="0,0,4,0"
                        Click="TabDictionaryBtn_Click">
                    <Grid>
                        <TextBlock Text="📖 DICTIONARY &amp; RULES" FontSize="10" FontWeight="Bold" />
                        <Border x:Name="TabDictionaryIndicator"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,-8"
                                Background="#52B788"
                                Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>

            <!-- ─── TAB 1: HISTORY VIEW ──────────────────────────────────── -->
            <Grid x:Name="HistoryViewPanel" Grid.Row="2" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Search & Filter Bar -->
                    <RowDefinition Height="36" />
                    <RowDefinition Height="8" />
                    <!-- History List Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search & Actions Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="{StaticResource Brush.Chassis.Inset}" BorderBrush="#2C2E35" BorderThickness="1" CornerRadius="2">
                        <Grid Margin="10,0">
                            <TextBlock x:Name="HistorySearchPlaceholder"
                                       Text="� Search past transcriptions &amp; corrections..."
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.ReadoutDim}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="HistorySearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource Brush.Text.Readout}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     TextChanged="HistorySearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Clear History Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource Style.Button.Transport}"
                            Padding="12,6"
                            Click="ClearHistoryBtn_Click">
                        <TextBlock Text="CLEAR LOG" FontSize="9.5" FontWeight="Bold" />
                    </Button>
                </Grid>

                <!-- History Items List -->
                <Border Grid.Row="2" Background="{StaticResource Brush.Chassis.Inset}" BorderBrush="#2A2C34" BorderThickness="1" CornerRadius="2">
                    <ListBox x:Name="HistoryListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1E23" BorderBrush="#2A2C34" BorderThickness="1" CornerRadius="2" Margin="8,4" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Header Row: Timestamp, Duration, Copy Button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeFormatted}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#9E9EA6" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding DurationFormatted}" FontSize="10" FontFamily="Consolas" Foreground="#666872" Margin="0,0,10,0" />
                                            </StackPanel>

                                            <!-- Copy Button -->
                                            <Button HorizontalAlignment="Right"
                                                    Style="{StaticResource Style.Button.Transport}"
                                                    Padding="10,4"
                                                    Click="CopyTranscriptBtn_Click"
                                                    Tag="{Binding FinalText}">
                                                <TextBlock Text="📋 COPY" FontSize="9" FontWeight="Bold" />
                                            </Button>
                                        </Grid>

                                        <!-- Correction Audit Badge (Visible only if correction applied) -->
                                        <Border Grid.Row="1"
                                                Background="#2E2008"
                                                BorderBrush="#8A5A14"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="8,3"
                                                Margin="0,0,0,8"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding HasCorrections, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡ CORRECTION APPLIED: " FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Correction.Badge}" />
                                                <TextBlock Text="{Binding CorrectionsSummary}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F0C068" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Final Transcribed Text -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding FinalText}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Brush.Text.Readout}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ─── TAB 2: DICTIONARY VIEW ───────────────────────────────── -->
            <Grid x:Name="DictionaryViewPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <!-- Controls Bar -->
                    <RowDefinition Height="36" />
                    <RowDefinition Height="8" />
                    <!-- Dictionary List Container -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Actions Bar -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search / Filter -->
                    <Border Grid.Column="0" Background="{StaticResource Brush.Chassis.Inset}" BorderBrush="#2C2E35" BorderThickness="1" CornerRadius="2">
                        <Grid Margin="10,0">
                            <TextBlock x:Name="DictSearchPlaceholder"
                                       Text="� Search dictionary words or replacement rules..."
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.ReadoutDim}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBox x:Name="DictSearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource Brush.Text.Readout}"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     TextChanged="DictSearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <!-- Add Entry Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource Style.Button.Transport}"
                            Padding="14,6"
                            Click="AddDictionaryBtn_Click">
                        <TextBlock Text="+ ADD ENTRY" FontSize="10" FontWeight="Bold" Foreground="#66D18E" />
                    </Button>

                    <!-- Open JSON file button -->
                    <Button Grid.Column="4"
                            Style="{StaticResource Style.Button.Transport}"
                            Padding="10,6"
                            Click="OpenDictFileBtn_Click"
                            ToolTip="Open dictionary.json file in editor">
                        <TextBlock Text="� JSON FILE" FontSize="9.5" FontWeight="Bold" />
                    </Button>
                </Grid>

                <!-- Dictionary Entries List -->
                <Border Grid.Row="2" Background="{StaticResource Brush.Chassis.Inset}" BorderBrush="#2A2C34" BorderThickness="1" CornerRadius="2">
                    <ListBox x:Name="DictionaryListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1C1E23" BorderBrush="#2A2C34" BorderThickness="1" CornerRadius="2" Margin="8,4" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Entry Details -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#121316" BorderBrush="#3A3C44" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayType}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" />
                                                </Border>
                                                <Border Background="#102518" BorderBrush="#286038" BorderThickness="1" CornerRadius="2" Padding="6,2"
                                                        Visibility="{Binding MatchGluedWords, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="GLUED WORDS SUPPORT" FontSize="8.5" FontWeight="Bold" Foreground="#52B788" />
                                                </Border>
                                            </StackPanel>

                                            <!-- The Rule / Keyword Text -->
                                            <TextBlock Text="{Binding DisplayRule}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Readout}" />
                                        </StackPanel>

                                        <!-- Action Buttons: Edit, Delete -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Style.Button.Transport}"
                                                    Padding="10,4"
                                                    Margin="0,0,6,0"
                                                    Click="EditDictEntryBtn_Click"
                                                    Tag="{Binding Id}">
                                                <TextBlock Text="EDIT" FontSize="9" FontWeight="Bold" />
                                            </Button>
                                            <Button Style="{StaticResource Style.Button.Transport}"
                                                    Padding="10,4"
                                                    Click="DeleteDictEntryBtn_Click"
                                                    Tag="{Binding Id}">
                                                <TextBlock Text="DEL" FontSize="9" FontWeight="Bold" Foreground="#E63946" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>

        <!-- ������������������������������������������������������������������ -->
        <!-- ROW 5: BOTTOM STATUS BAR STRIP                                     -->
        <!-- ������������������������������������������������������������������ -->
        <Border Grid.Row="5" Background="#121316" BorderBrush="#2A2C34" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Text="ECHO AUDIO CORP. • ALL SPEECH PROCESSED FULLY ON-DEVICE • NO CLOUD TELEMETRY"
                           FontSize="9" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" />
                <TextBlock Grid.Column="1" Text="STEREO HI-FI 16-BIT / 16000Hz"
                           FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#555866" />
            </Grid>
        </Border>

        <!-- ������������������������������������������������������������������ -->
        <!-- MODAL OVERLAY: ADD / EDIT DICTIONARY ENTRY DIALOG                  -->
        <!-- ������������������������������������������������������������������ -->
        <Grid x:Name="DictModalOverlay" Grid.RowSpan="6" Background="#B0000000" Visibility="Collapsed">
            <Border Width="500" Background="{StaticResource Brush.Chassis.Panel}" BorderBrush="#3A3C44" BorderThickness="2" CornerRadius="4" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ModalTitleText" Text="ADD DICTIONARY ENTRY" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Text.SilkscreenBright}" Margin="0,0,0,16" />

                    <!-- Entry Type Selector -->
                    <TextBlock Text="ENTRY TYPE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="RadioCorrection" Content="Correction Pair (When you hear X → write Y)" IsChecked="True" Foreground="{StaticResource Brush.Text.Readout}" Margin="0,0,16,0" Checked="RadioType_Checked" />
                        <RadioButton x:Name="RadioKeyword" Content="Vocabulary Keyword" Foreground="{StaticResource Brush.Text.Readout}" Checked="RadioType_Checked" />
                    </StackPanel>

                    <!-- From Input -->
                    <TextBlock x:Name="LabelFromText" Text="WHEN YOU HEAR (SPOKEN PHRASE):" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,0,0,6" />
                    <Border Background="{StaticResource Brush.Chassis.Inset}" BorderBrush="#3A3C44" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,4">
                        <TextBox x:Name="ModalFromBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text.Readout}" FontSize="13" TextChanged="ModalFromBox_TextChanged" />
                    </Border>

                    <!-- Collision Warning Alert Box -->
                    <Border x:Name="CollisionWarningBox" Background="#2E1C05" BorderBrush="#D48B1E" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="CollisionWarningText" Text="Warning: ..." FontSize="10.5" Foreground="#F0A83A" TextWrapping="Wrap" />
                    </Border>

                    <!-- To Input (Correction only) -->
                    <StackPanel x:Name="ModalToSection" Margin="0,8,0,14">
                        <TextBlock Text="REPLACE WITH (WRITTEN FORMAT):" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,0,0,6" />
                        <Border Background="{StaticResource Brush.Chassis.Inset}" BorderBrush="#3A3C44" BorderThickness="1" CornerRadius="2" Padding="8,6">
                            <TextBox x:Name="ModalToBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Brush.Text.Readout}" FontSize="13" />
                        </Border>
                    </StackPanel>

                    <!-- Glued words toggle -->
                    <CheckBox x:Name="ModalGluedCheck" Content="Match glued words (e.g. 'CloudCode' &amp; 'Cloud-Code' → 'Claude Code')" IsChecked="True" Foreground="{StaticResource Brush.Text.Readout}" FontSize="11" Margin="0,0,0,20" />

                    <!-- Dialog Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Style.Button.Transport}" Padding="16,8" Margin="0,0,10,0" Click="ModalCancelBtn_Click">
                            <TextBlock Text="CANCEL" FontSize="11" FontWeight="Bold" />
                        </Button>
                        <Button Style="{StaticResource Style.Button.Transport}" Padding="20,8" Click="ModalSaveBtn_Click">
                            <TextBlock Text="SAVE ENTRY" FontSize="11" FontWeight="Bold" Foreground="#52B788" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
