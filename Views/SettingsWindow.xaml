<Window x:Class="Echo.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Echo.Controls"
        Title="Echo | Settings"
        Width="1000" Height="660"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource Brush.Light.Page}"
        Foreground="{StaticResource Brush.Light.Text}"
        FontFamily="Segoe UI, Inter, Arial"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Win11's Aero ComboBox/TextBox templates paint text with the SYSTEM
                 brushes, and DesignTokens overrides those globally to near-white for
                 the old dark chassis — invisible on these light cards. Scope light
                 values to this window (closed box AND popup inherit them). -->
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#0F172A" />
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#0F172A" />
            <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#94A3B8" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0E7FF" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />

            <Style x:Key="Style.SettingsComboItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titlebar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Brush.Light.BorderSoft}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource Style.TitlebarIconButton}" Click="CloseBtn_Click" ToolTip="Close settings">
                        <TextBlock Text="✕" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Light.Sidebar}" BorderBrush="{StaticResource Brush.Light.BorderSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,18,0,0">
                        <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Light.TextFaint}" Margin="20,0,0,8" />
                        <ToggleButton x:Name="NavGeneralBtn" Content="General" Tag="&#xE70F;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="True" Click="NavGeneralBtn_Click" />
                        <ToggleButton x:Name="NavSystemBtn" Content="System" Tag="&#xE713;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="False" Click="NavSystemBtn_Click" />
                        <ToggleButton x:Name="NavVibeBtn" Content="Vibe coding" Tag="&#xE794;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="False" Click="NavVibeBtn_Click" />
                        <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Light.TextFaint}" Margin="20,18,0,8" />
                        <ToggleButton x:Name="NavAccountBtn" Content="Account" Tag="&#xE77B;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="False" Click="NavAccountBtn_Click" />
                        <ToggleButton x:Name="NavTeamBtn" Content="Team" Tag="&#xE716;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="False" Click="NavTeamBtn_Click" />
                        <ToggleButton x:Name="NavPlansBtn" Content="Plans and Billing" Tag="&#xE719;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="False" Click="NavPlansBtn_Click" />
                        <ToggleButton x:Name="NavPrivacyBtn" Content="Data and Privacy" Tag="&#xE72E;" Style="{StaticResource Style.SidebarNavItem}" IsChecked="False" Click="NavPrivacyBtn_Click" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Echo v1.0.0" FontSize="11" Foreground="{StaticResource Brush.Light.TextFaint}" Margin="20,0,0,16" />
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="36,28,36,28">
                <Grid>
                    <!-- GENERAL -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Visible">
                        <TextBlock Text="General" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" Margin="0,0,0,20" />
                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,8">
                            <StackPanel>
                                <!-- Shortcuts -->
                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Shortcuts" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                        <TextBlock x:Name="HotkeyHintText" Text="Hold Right Control and speak." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="HotkeyCombo" Grid.Column="1" Width="280" VerticalAlignment="Center" FontSize="12" Padding="8,6" Foreground="#0F172A" Background="White" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectedIndex="0" SelectionChanged="HotkeyCombo_SelectionChanged">
                                        <ComboBoxItem Content="Right Control (Recommended — zero conflicts)" Tag="163" />
                                        <ComboBoxItem Content="Right Alt" Tag="165" />
                                        <ComboBoxItem Content="Right Shift" Tag="161" />
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Brush.Light.BorderSoft}" />
                                <!-- Microphone -->
                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Microphone" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                        <TextBlock x:Name="MicHintText" Text="Input device used for dictation." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="AudioDeviceCombo" Grid.Column="1" Width="280" VerticalAlignment="Center" FontSize="12" Padding="8,6" Foreground="#0F172A" Background="White" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectionChanged="AudioDeviceCombo_SelectionChanged" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource Brush.Light.BorderSoft}" />
                                <!-- Dictation languages -->
                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Dictation Languages" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                        <TextBlock x:Name="SpokenLangHintText" Text="Language you speak while dictating. Multilingual engines honor it." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="SpokenLanguageCombo" Grid.Column="1" Width="280" VerticalAlignment="Center" FontSize="12" Padding="8,6" Foreground="#0F172A" Background="White" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectionChanged="SpokenLanguageCombo_SelectionChanged">
                                        <ComboBoxItem Content="Auto-detect" Tag="" />
                                        <ComboBoxItem Content="English" Tag="en" />
                                        <ComboBoxItem Content="Hindi (हिन्दी)" Tag="hi" />
                                        <ComboBoxItem Content="Marathi (मराठी)" Tag="mr" />
                                        <ComboBoxItem Content="Bengali (বাংলা)" Tag="bn" />
                                        <ComboBoxItem Content="Tamil (தமிழ்)" Tag="ta" />
                                        <ComboBoxItem Content="Telugu (తెలుగు)" Tag="te" />
                                        <ComboBoxItem Content="Gujarati (ગુજરાતી)" Tag="gu" />
                                        <ComboBoxItem Content="Kannada (ಕನ್ನಡ)" Tag="kn" />
                                        <ComboBoxItem Content="Malayalam (മലയാളം)" Tag="ml" />
                                        <ComboBoxItem Content="Punjabi (ਪੰਜਾਬੀ)" Tag="pa" />
                                        <ComboBoxItem Content="Urdu (اردو)" Tag="ur" />
                                    </ComboBox>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Brush.Light.BorderSoft}" />
                                <!-- App language -->
                                <Grid Margin="0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="App Language" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                        <TextBlock Text="Language of the Echo interface." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center" FontSize="12" Padding="8,6" Foreground="#0F172A" Background="White" SelectedIndex="0" IsEnabled="False">
                                        <ComboBoxItem Content="English" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SYSTEM -->
                    <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                        <TextBlock Text="System" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" Margin="0,0,0,20" />
                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="Speech recognition engine" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                <ComboBox x:Name="SttEngineCombo" Margin="0,10,0,0" FontSize="12" Padding="8,6" Foreground="#0F172A" Background="White" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectionChanged="SttEngineCombo_SelectionChanged">
                                    <ComboBoxItem Content="Whisper Base Multilingual (~142 MB) — 100% offline" />
                                    <ComboBoxItem Content="Whisper Small English (~465 MB) — 100% offline" />
                                    <ComboBoxItem Content="Parakeet TDT 0.6B V3 (~670 MB) — local, fast, English" />
                                    <ComboBoxItem Content="Groq Whisper Large V3 Turbo — free cloud, best accuracy" />
                                </ComboBox>
                                <TextBlock x:Name="SttEngineStatus" Text="" FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button x:Name="DownloadEngineButton" Style="{StaticResource Style.Button.Primary}" Padding="16,8" Margin="0,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="DownloadEngineButton_Click">
                                    <TextBlock x:Name="DownloadEngineButtonText" Text="DOWNLOAD" FontSize="11" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox x:Name="EnableVadCheckBox" Content="Auto-stop on silence (Silero VAD v5, bundled)" IsChecked="True" Foreground="{StaticResource Brush.Light.Text}" FontSize="13" FontWeight="SemiBold" Click="EnableVadCheckBox_Changed" />
                                <TextBlock Text="When on, push-to-talk ends automatically after ~500ms of silence. When off, the whole held-key duration is recorded." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="24,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Groq API key" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                <TextBlock Text="Free, no credit card. Only needed for the Groq cloud engine." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,4,0,10" />
                                <PasswordBox x:Name="GroqApiKeyBox" FontSize="12" Padding="10,8" Background="White" Foreground="#0F172A" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" PasswordChanged="GroqApiKeyBox_PasswordChanged" />
                                <TextBlock FontSize="12" Margin="0,8,0,0">
                                    <Hyperlink NavigateUri="https://console.groq.com/keys" RequestNavigate="GroqKeyLink_RequestNavigate">
                                        Get a free Groq API key
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Installed models" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" Margin="0,0,0,10" />
                                <Border Background="{StaticResource Brush.Slate.100}" CornerRadius="8" Padding="12,10" MaxHeight="180">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="DownloadedModelsList" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- VIBE CODING -->
                    <StackPanel x:Name="VibePanel" Visibility="Collapsed">
                        <TextBlock Text="Vibe coding" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" Margin="0,0,0,20" />
                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="Personal vocabulary" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                <TextBlock x:Name="VocabCountText" Text="Words the recognizer biases toward and auto-corrects live in Transforms." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <Border Background="{StaticResource Brush.Slate.100}" CornerRadius="8" Padding="12,10" MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="VocabPreviewText" FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ACCOUNT / TEAM / PLANS (local-first product: no cloud account) -->
                    <StackPanel x:Name="AccountPanel" Visibility="Collapsed">
                        <TextBlock x:Name="AccountTitle" Text="Account" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" Margin="0,0,0,20" />
                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="Local-first — no account needed" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                <TextBlock x:Name="AccountBody" Text="Echo runs on your machine. Dictation, history, and vocabulary never leave this PC unless you pick the Groq cloud engine. There is nothing to sign into, no team to invite, and nothing to pay." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- DATA AND PRIVACY -->
                    <StackPanel x:Name="PrivacyPanel" Visibility="Collapsed">
                        <TextBlock Text="Data and Privacy" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" Margin="0,0,0,20" />
                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Text="On-device by default" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                <TextBlock Text="Whisper and Parakeet transcribe locally — audio never leaves your PC. Groq sends audio to the cloud only when you select that engine. Diagnostic logs live in %LOCALAPPDATA%\Echo\logs." FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="{StaticResource Brush.Light.Border}" BorderThickness="1" CornerRadius="14" Padding="22,18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Dictation history" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Light.Text}" />
                                <TextBlock x:Name="HistoryCountText" Text="" FontSize="12" Foreground="{StaticResource Brush.Light.TextDim}" Margin="0,6,0,10" />
                                <Button x:Name="ClearHistoryButton" Style="{StaticResource Style.Button.Ghost}" Padding="14,7" HorizontalAlignment="Left" Click="ClearHistoryButton_Click">
                                    <TextBlock Text="CLEAR HISTORY" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
