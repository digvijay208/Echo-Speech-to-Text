<Window x:Class="Echo.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECHO TC-80 | System Settings"
        Width="540" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Chassis.BodyDark}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/DesignTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Override the system brush the popup hosts in, otherwise the popup
                 window is composed on top of the system Window brush (light). -->
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#121316" />
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#121316" />
            <!-- The popup lives in a separate HWND and ignores most inherited Foreground.
                 Force the system "control text" brush to the light readout color so every
                 TextBlock/ContentPresenter inside the dropdown renders in light text. -->
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F4F4F6" />
            <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7A7C85" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1F3849" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#52B788" />

            <Style x:Key="Style.SettingsCombo" TargetType="ComboBox">
                <Setter Property="Background" Value="#121316" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Readout}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text.Readout}" />
                <Setter Property="TextElement.FontSize" Value="12" />
                <Setter Property="BorderBrush" Value="#3A3C44" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MaxDropDownHeight" Value="320" />
                <!-- Custom template: Aero theme on Win11 ignores Foreground on the
                     selection box ContentPresenter and renders the popup with a light
                     system border. We rebuild both so text is visible on the dark chassis. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="templateBorder"
                                        Grid.ColumnSpan="2"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2">
                                    <Grid>
                                        <ToggleButton x:Name="toggleButton"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press"
                                                      Focusable="False"
                                                      OverridesDefaultStyle="True">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="arrow"
                                                              Data="M 0 0 L 5 5 L 10 0"
                                                              Stroke="#9E9EA6"
                                                              StrokeThickness="1.5"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,12,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="contentPresenter"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          IsHitTestVisible="False"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Grid>
                                </Border>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="False"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="0,1,0,0"
                                       Placement="Bottom"
                                       PopupAnimation="None"
                                       Focusable="False">
                                    <Border x:Name="dropDownBorder"
                                            Background="#121316"
                                            BorderBrush="#3A3C44"
                                            BorderThickness="1"
                                            CornerRadius="2"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            MinWidth="{Binding ActualWidth, ElementName=templateBorder}">
                                        <ScrollViewer Background="#121316">
                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBoxItem foreground ? must be set explicitly because the items live
                 inside the popup, which the custom template renders without inheriting
                 the parent ComboBox.Foreground. -->
            <Style x:Key="Style.SettingsComboItem" TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#121316" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Readout}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="SemiBold"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1F3849" />
                                    <Setter Property="Foreground" Value="#52B788" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#555760" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Brushed Header Strip -->
            <RowDefinition Height="46" />
            <!-- Milled Seam -->
            <RowDefinition Height="2" />
            <!-- Settings Form Bay -->
            <RowDefinition Height="*" />
            <!-- Bottom Action Strip -->
            <RowDefinition Height="46" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Chassis.BrushedMetal}" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CALIBRATION &amp; CONFIGURATION"
                               FontFamily="Segoe UI, Arial"
                               FontWeight="Black"
                               FontSize="13"
                               Foreground="#1B1C20"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="MODEL TC-80"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#555760"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Seam -->
        <Border Grid.Row="1" Style="{StaticResource Style.Panel.Seam}" />

        <!-- Form Panels -->
        <ScrollViewer Grid.Row="2" Margin="20,16">
            <StackPanel>
                <!-- Hotkey Section -->
                <Border Background="{StaticResource Brush.Chassis.Panel}" BorderBrush="#2E3036" BorderThickness="1" CornerRadius="2" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="GLOBAL PUSH-TO-TALK SHORTCUT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,0,0,8" />
                        <ComboBox x:Name="HotkeyCombo" Style="{StaticResource Style.SettingsCombo}" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectedIndex="0" SelectionChanged="HotkeyCombo_SelectionChanged">
                            <ComboBoxItem Content="Right Control (Recommended - zero conflicts)" Tag="163" />
                            <ComboBoxItem Content="Right Alt" Tag="165" />
                            <ComboBoxItem Content="Right Shift" Tag="161" />
                        </ComboBox>
                        <TextBlock Text="Hold this key inside any Windows app to capture audio. Release to transcribe &amp; type."
                                   FontSize="11" Foreground="{StaticResource Brush.Text.ReadoutDim}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Model Section -->
                <Border Background="{StaticResource Brush.Chassis.Panel}" BorderBrush="#2E3036" BorderThickness="1" CornerRadius="2" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SPEECH RECOGNITION NEURAL MODEL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,0,0,8" />
                        <ComboBox x:Name="ModelCombo" Style="{StaticResource Style.SettingsCombo}" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectedIndex="0" SelectionChanged="ModelCombo_SelectionChanged">
                            <ComboBoxItem Content="Large V3 Multilingual (~2.9 GB) ? Highest Accuracy, 99 Languages" Tag="large-v3" />
                            <ComboBoxItem Content="Medium Multilingual (~1.4 GB) ? High Accuracy, 99 Languages" Tag="medium" />
                            <ComboBoxItem Content="Small Multilingual (~465 MB) ? Balanced Multilingual" Tag="small" />
                            <ComboBoxItem Content="Base Multilingual (~142 MB) ? All Languages" Tag="base" />
                            <ComboBoxItem Content="Tiny Multilingual (~75 MB) ? Fast Multilingual" Tag="tiny" />
                            <ComboBoxItem Content="Base English (~142 MB) ? Best for English Only" Tag="base.en" />
                            <ComboBoxItem Content="Tiny English (~75 MB) ? Fastest English" Tag="tiny.en" />
                            <ComboBoxItem Content="Small English (~465 MB) ? High English Accuracy" Tag="small.en" />
                        </ComboBox>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="ModelStatusText" Text="Checking model status..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.ReadoutDim}" />
                                <ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,8,16,0" Foreground="#52B788" Background="#121316" Visibility="Collapsed" />
                            </StackPanel>

                            <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource Style.Button.Transport}" Padding="16,8" Click="DownloadButton_Click">
                                <TextBlock Text="DOWNLOAD" FontSize="10" FontWeight="Bold" />
                            </Button>
                        </Grid>

                        <!-- Downloaded Models List: shows every model on disk so the user can
                             see at a glance what is installed, regardless of which entry is
                             selected in the dropdown above. -->
                        <TextBlock Text="DOWNLOADED MODELS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,16,0,8" />
                        <Border Background="#0A0A0C" BorderBrush="#2E3036" BorderThickness="1" CornerRadius="2" Padding="10,8" MaxHeight="180">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DownloadedModelsList" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Audio Input Section -->
                <Border Background="{StaticResource Brush.Chassis.Panel}" BorderBrush="#2E3036" BorderThickness="1" CornerRadius="2" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="WASAPI AUDIO INPUT ENDPOINT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Silkscreen}" Margin="0,0,0,8" />
                        <ComboBox x:Name="AudioDeviceCombo" Style="{StaticResource Style.SettingsCombo}" ItemContainerStyle="{StaticResource Style.SettingsComboItem}" SelectionChanged="AudioDeviceCombo_SelectionChanged" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="3" Background="#121316" BorderBrush="#2A2C34" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock Text="Press Ctrl+, anytime to reopen settings" FontSize="9.5" Foreground="{StaticResource Brush.Text.Silkscreen}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource Style.Button.Transport}" Padding="20,6" Click="CloseBtn_Click">
                    <TextBlock Text="DONE" FontSize="10" FontWeight="Bold" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
